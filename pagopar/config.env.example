# =============================================================================
# MANASTINA · PagoPar — configuración
# =============================================================================
# Estas variables son SECRETOS del servidor (Edge Functions de Supabase).
# NO van en el HTML ni se suben a git. Se cargan una sola vez con:
#
#   supabase secrets set --env-file pagopar/config.env
#
# Pasos:
#   1) Copiá este archivo a  pagopar/config.env   (sin ".example")
#   2) Completá todo lo que diga  <<< COMPLETAR >>>
#   3) Corré el comando de arriba
#   4) Avisame y yo despliego las funciones
#
# El archivo pagopar/config.env está en .gitignore: no se sube a GitHub.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) CLAVES DE PAGOPAR                                        [ IMPRESCINDIBLE ]
# -----------------------------------------------------------------------------
# Dónde: panel de PagoPar -> Comercio -> Datos del comercio / Integración.
# Son dos strings largos. La PRIVADA no se muestra nunca en el navegador:
# firma el token SHA1 de cada cobro y valida el aviso de pago.
#
# ⚠️ No me las mandes por chat. Pegalas acá y ya.

PAGOPAR_PUBLIC_KEY=<<< COMPLETAR >>>
PAGOPAR_PRIVATE_KEY=<<< COMPLETAR >>>

# production = cobros reales. staging = pruebas (si PagoPar te dio claves de test).
PAGOPAR_ENV=production


# -----------------------------------------------------------------------------
# 2) SUPABASE                                                 [ IMPRESCINDIBLE ]
# -----------------------------------------------------------------------------
# ¿Es el mismo Supabase que usa tradexpar (https://api.neura.com.py) o hay uno
# aparte para Manastina? Pegá la URL del proyecto donde van a vivir los pedidos.

SUPABASE_PROJECT_URL=https://api.neura.com.py

# La "anon key" (clave pública, la que SÍ puede ir en el navegador). La saco del
# panel: Project Settings -> API -> anon / public.
SUPABASE_ANON_KEY=<<< COMPLETAR >>>

# Schema donde creo la tabla de pedidos. Dejalo así salvo que prefieras otro.
SUPABASE_SCHEMA=manastina

# NOTA: SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY NO hacen falta acá —
# Supabase se las inyecta solas a las Edge Functions.


# -----------------------------------------------------------------------------
# 3) URLS DEL SITIO                                           [ IMPRESCINDIBLE ]
# -----------------------------------------------------------------------------
# Dominio público (sin barra al final).
SITIO_URL=https://manastina.com

# A dónde vuelve el cliente después de pagar. Yo creo esta página.
PAGOPAR_RETURN_URL=https://manastina.com/pago.html?hash=${hash}

# A dónde avisa PagoPar el resultado del cobro (server-to-server).
# Reemplazá <SUPABASE_PROJECT_URL> por lo mismo que pusiste arriba.
PAGOPAR_WEBHOOK_URL=<<< COMPLETAR >>>/functions/v1/pagopar-webhook


# -----------------------------------------------------------------------------
# 4) DATOS DEL COMERCIO                                         [ TE LOS PIDO ]
# -----------------------------------------------------------------------------
# PagoPar exige estos datos del VENDEDOR dentro de cada pedido.

# Teléfono del local, solo dígitos con código de país. Ej: 595981123456
PAGOPAR_VENDEDOR_TELEFONO=

# Dirección exacta del local en Capiatá (calle y número).
PAGOPAR_VENDEDOR_DIRECCION=

# Referencia / entre calles. Si no hay, dejalo vacío.
PAGOPAR_VENDEDOR_DIRECCION_REFERENCIA=

# Coordenadas "lat,lng". Las saco del Google Maps que ya está en la web,
# pero confirmame que el pin es el local real.
PAGOPAR_VENDEDOR_DIRECCION_COORDENADAS=-25.3949853,-57.4712114

# Código de ciudad del vendedor (hub PagoPar). 5 = Capiatá.
PAGOPAR_ITEM_CIUDAD=5


# -----------------------------------------------------------------------------
# 5) PARÁMETROS DE PAGOPAR                                       [ A CONFIRMAR ]
# -----------------------------------------------------------------------------
# forma_pago: 9 = mostrar TODOS los medios habilitados (tarjeta, Tigo Money,
# Personal, Aqui Pago, Practipago, transferencia...). Recomiendo dejar 9.
# Si querés limitar a alguno, decime cuáles y lo cambio.
PAGOPAR_FORMA_PAGO=9

# ID de categoría de producto en PagoPar. 909 = genérico.
# Si en el panel de Manastina te asignaron una categoría propia
# (marroquinería / accesorios), pasámela y la pongo acá.
PAGOPAR_ITEM_CATEGORIA=909

# Días que el link de pago sigue vivo antes de vencer.
PAGOPAR_DIAS_VENCIMIENTO=3


# -----------------------------------------------------------------------------
# 6) ENVIO                                                          [ TARIFAS ]
# -----------------------------------------------------------------------------
# PagoPar cobra un monto cerrado, asi que la tarifa tiene que estar decidida
# antes de generar el link. Por eso la tabla de abajo.
#
# En el checkout el cliente elige su ciudad y ve el costo al instante, y despues
# elige si lo paga ahora junto con la compra, o si se lo abona al repartidor
# cuando recibe. En los dos casos el ERP sabe cuanto es.
#
# Ciudades fuera de esta lista: el cliente elige "Otra ciudad", no se le cobra
# envio online, y el costo se acuerda por WhatsApp y se cobra al entregar.
#
# Para cambiar un precio: editas el numero y volves a correr
#   supabase secrets set --env-file pagopar/config.env
# No hace falta tocar codigo ni volver a desplegar las funciones.
#
# Las claves son las de supabase/functions/_shared/ciudades.ts
ENVIO_TARIFAS_JSON={"capiata":10000,"san-lorenzo":10000,"j-augusto-saldivar":10000,"nemby":15000,"ypane":15000,"itaugua":20000,"fernando-de-la-mora":20000,"aregua":20000,"villa-elisa":20000,"luque":20000,"san-antonio":20000,"asuncion":20000,"lambare":20000,"ita":20000,"mariano-roque-alonso":30000,"limpio":30000}

# Envio gratis a partir de este monto de compra. Vacio o 0 = nunca.
ENVIO_GRATIS_DESDE=

# -----------------------------------------------------------------------------
# 7) AVISOS                                                       [ OPCIONAL ]
# -----------------------------------------------------------------------------
# Mail donde llega el aviso cuando entra un pago aprobado. Vacío = sin mail.
NOTIFICAR_EMAIL=

# WhatsApp de Manastina para el aviso de pedido pagado (solo dígitos).
NOTIFICAR_WHATSAPP=

# -----------------------------------------------------------------------------
# 8) ENGANCHE CON EL ERP                                          [ OPCIONAL ]
# -----------------------------------------------------------------------------
# UUID de Manastina en manastina.empresas. Se guarda en cada pedido web para
# que el ERP sepa a qué empresa pertenece. Se puede dejar vacío y completar
# después; no bloquea el cobro.
MANASTINA_EMPRESA_ID=
